<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1180.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.goierri.jatetxea.controller.SukaldeaController">
    <!-- 1. GOIKO NABIGAZIO-BARRA -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Label styleClass="brand-label" text="T1 Jatetxea" />
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 18px;" text="|" />
            <Label styleClass="title-label" text="Sukaldeko KDS Pantaila" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" spacing="8.0">
                <Button mnemonicParsing="false" styleClass="nav-button-active" text="Sukaldea (KDS)" />
                <Button mnemonicParsing="false" onAction="#onBarraClick" styleClass="nav-button" text="Barra (BDS)" />
                <Button mnemonicParsing="false" onAction="#onBiltegiaClick" styleClass="nav-button" text="Biltegia (Stocka)" />
            </HBox>
            
            <Region prefWidth="16.0" />
            
            <CheckBox fx:id="chkAutoRefresh" mnemonicParsing="false" selected="true" text="Auto-Freskatu (10s)" />
            <Button mnemonicParsing="false" onAction="#onFreskatuClick" styleClass="btn-secondary" text="Freskatu" />
        </HBox>
    </top>

    <!-- 2. ERDIKO EDUKIA: ESKAERAK ETA PLATEREN KUDEAKETA -->
    <center>
        <SplitPane dividerPositions="0.45" orientation="HORIZONTAL" style="-fx-background-color: transparent; -fx-padding: 16;">
            <!-- EZKERREKO PANELA: ESKAERA AKTIBOAK -->
            <VBox spacing="12.0" styleClass="card-panel">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Eskaera Aktiboak (Sukaldean)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblEskaeraKopurua" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #881337;" text="0 eskaera" />
                </HBox>
                
                <TableView fx:id="tblEskaerak" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEskaeraId" prefWidth="65.0" text="# ID" />
                        <TableColumn fx:id="colMahaia" prefWidth="95.0" text="Mahaia" />
                        <TableColumn fx:id="colLangilea" prefWidth="120.0" text="Zerbitzaria" />
                        <TableColumn fx:id="colEgoera" prefWidth="105.0" text="Egoera" />
                        <TableColumn fx:id="colPlaterak" prefWidth="75.0" text="Platerak" />
                        <TableColumn fx:id="colOrdua" prefWidth="120.0" text="Ordua" />
                    </columns>
                    <placeholder>
                        <Label text="Ez dago eskaera aktiborik une honetan." />
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button mnemonicParsing="false" onAction="#onEskaeraEgindaClick" styleClass="btn-success" text="Sukaldeko Platerak Eginda Markatu" />
                </HBox>
            </VBox>

            <!-- ESKUINEKO PANELA: HAUTATUTAKO ESKAERAREN PLATERAK ETA EKINTZAK -->
            <VBox spacing="12.0" styleClass="card-panel">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblHautatutakoEskaera" styleClass="card-title" text="Hautatutako Eskaeraren Platerak" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblPlaterKopurua" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="0 plater" />
                </HBox>

                <TableView fx:id="tblLerroak" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLerroPlatera" prefWidth="175.0" text="Platera" />
                        <TableColumn fx:id="colLerroKop" prefWidth="55.0" text="Kop" />
                        <TableColumn fx:id="colLerroOharrak" prefWidth="145.0" text="Sukaldeko Oharrak" />
                        <TableColumn fx:id="colLerroEgoera" prefWidth="105.0" text="Egoera" />
                        <TableColumn fx:id="colLerroEkintza" prefWidth="130.0" text="Ekintza Azkarra" />
                    </columns>
                    <placeholder>
                        <Label text="Aukeratu eskaera bat ezkerreko taulan xehetasunak ikusteko." />
                    </placeholder>
                </TableView>

                <!-- PLATERAREN EGOERA ALDATZEKO BOTOIAK -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button mnemonicParsing="false" onAction="#onPlateraZaiClick" styleClass="btn-secondary" text="Zai jarri" />
                    <Button mnemonicParsing="false" onAction="#onPlateraMartxanClick" styleClass="btn-warning" text="Martxan jarri" />
                    <Button mnemonicParsing="false" onAction="#onPlateraEgindaClick" styleClass="btn-success" text="Eginda markatu" />
                </HBox>
            </VBox>
        </SplitPane>
    </center>

    <!-- 3. BEHEKO EGOERA-BARRA -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="status-bar">
            <Label fx:id="lblKonexioa" styleClass="status-ok" text="API konexioa: Egiaztatzen..." />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblEgoeraMezua" styleClass="status-text" text="Prest" />
            <Label fx:id="lblAzkenFreskatzea" styleClass="status-text" text="Azken freskatzea: -" />
        </HBox>
    </bottom>
</BorderPane>
