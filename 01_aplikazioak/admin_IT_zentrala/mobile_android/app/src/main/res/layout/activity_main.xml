<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- GOIKO AGINTE-BARRA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/card_dark">

        <!-- LOGOA ETA IZENBURUA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1T IT KONTROL ZENTRALA"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCurrentHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://localhost:5000"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- EGOERA TXAPA -->
        <LinearLayout
            android:id="@+id/pillStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@color/bg_dark"
            android:layout_marginEnd="8dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/status_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LINEAN"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AUKERAK / IP BOTOIA -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Ezarpenak"
            android:tint="@color/text_light"
            android:layout_marginEnd="4dp" />

        <!-- FRESKATU BOTOIA -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Freskatu"
            android:tint="@color/text_light" />
    </LinearLayout>

    <!-- PROGRESU-BARRA -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/primary"
        android:visibility="gone" />

    <!-- EDUKIA / SWIPE REFRESH -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- WEBVIEW NAGUSIA -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- ERRORE-PANELA (KONEXIOIK EZ BADAGO) -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@color/bg_dark"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/stat_notify_error"
                    android:tint="@color/status_red"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ezin izan da zerbitzariarekin konektatu"
                    android:textColor="@color/text_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvErrorDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ziurtatu 'Jatetxea.AdminZentrala' martxan dagoela ordenagailuan (Portua: 5000) eta gailua USB bidez edo WiFi sare berean konektatuta dagoela."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnConnectUsb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="USB Konexioa (localhost:5000)"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_light"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnConnectWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WiFi Konexioa (192.168.1.168:5000)"
                    android:backgroundTint="@color/card_dark"
                    android:textColor="@color/text_light"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Birkonektatu Orain"
                    android:backgroundTint="#334155"
                    android:textColor="@color/text_light" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
