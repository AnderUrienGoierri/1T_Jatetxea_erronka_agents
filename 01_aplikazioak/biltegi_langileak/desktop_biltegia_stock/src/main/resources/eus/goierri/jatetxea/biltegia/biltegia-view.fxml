<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1180.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.goierri.jatetxea.biltegia.controller.BiltegiaController">
    <!-- 1. GOIKO NABIGAZIO-BARRA -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Label styleClass="brand-label" text="T1 Jatetxea" />
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 18px;" text="|" />
            <Label styleClass="title-label" text="Biltegiko Stock Kudeaketa" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" spacing="8.0">
                <Label style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 4;" text="Biltegia (Stocka)" />
            </HBox>
            
            <Region prefWidth="16.0" />
            
            <Button mnemonicParsing="false" onAction="#onKargatuDatuakClick" styleClass="btn-primary" text="Freskatu Datuak" />

            <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 0 0 0 12; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1;">
                <Label fx:id="lblErabiltzaileaInfo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Langilea" />
                <Button mnemonicParsing="false" onAction="#onSaioaItxiClick" style="-fx-background-color: #881337; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 4; -fx-cursor: hand;" text="Saioa Itxi" />
            </HBox>
        </HBox>
    </top>

    <!-- 2. ERDIKO EDUKIA: KPI TXARTELAK, BILAKETA ETA TAULA -->
    <center>
        <VBox spacing="16.0" style="-fx-padding: 16;">
            <!-- LABURPEN KPI TXARTELAK -->
            <HBox spacing="16.0">
                <VBox prefWidth="240.0" styleClass="card-panel">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="GUZTIRA LEHENGAIAK" />
                    <Label fx:id="lblKpiGuztira" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Erregistratutako produktuak" />
                </VBox>

                <VBox prefWidth="240.0" styleClass="card-panel">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b45309;" text="STOCK BAXUKO ALERTAK" />
                    <Label fx:id="lblKpiAlertak" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #b45309;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Gutxieneko mailatik behera" />
                </VBox>

                <VBox prefWidth="240.0" styleClass="card-panel">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="AGORTUTAKO PRODUKTUAK" />
                    <Label fx:id="lblKpiAgortuta" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Stocka = 0 dutenak" />
                </VBox>
            </HBox>

            <!-- BILAKETA ETA IRAGAZKIAK -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card-panel">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Bilatu:" />
                <TextField fx:id="txtBilaketa" prefWidth="280.0" promptText="Idatzi lehengaiaren izena edo hornitzailea..." />
                
                <CheckBox fx:id="chkAlertakSoilik" mnemonicParsing="false" text="Stock baxuko alertak soilik erakutsi" />
                
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTaulaKopurua" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="0 produktu" />
            </HBox>

            <!-- TAULA ETA SARRERA FORMA BANATUA -->
            <SplitPane dividerPositions="0.65" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                <!-- LEHENGAIEN ZERRENDA -->
                <VBox spacing="10.0" styleClass="card-panel">
                    <Label styleClass="card-title" text="Biltegiko Produktuak eta Stock Maila" />
                    
                    <TableView fx:id="tblLehengaiak" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="50.0" text="# ID" />
                            <TableColumn fx:id="colIzena" prefWidth="170.0" text="Lehengaia / Produktua" />
                            <TableColumn fx:id="colUnekoStocka" prefWidth="105.0" text="Uneko Stocka" />
                            <TableColumn fx:id="colGutxienekoa" prefWidth="100.0" text="Gutxienekoa" />
                            <TableColumn fx:id="colKostua" prefWidth="90.0" text="Kostu Unitar." />
                            <TableColumn fx:id="colHornitzailea" prefWidth="175.0" text="Hornitzailea" />
                            <TableColumn fx:id="colEgoera" prefWidth="115.0" text="Egoera" />
                        </columns>
                        <placeholder>
                            <Label text="Ez da lehengairik aurkitu." />
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- ESKUINEKO PANELA: HORNIDURA BERRIA ETA KOBRO SIMULAZIOA -->
                <VBox spacing="10.0" styleClass="card-panel">
                    <Label styleClass="card-title" text="Albaran Sarrera eta Ordainketa" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Aukeratu hornitzailea eta produktua: stocka automatikoki igoko da eta erosketa-faktura sortuko da." wrapText="true" />

                    <VBox spacing="3.0">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="1. Aukeratu Hornitzailea:" />
                        <ComboBox fx:id="cmbHornitzailea" maxWidth="Infinity" promptText="Aukeratu hornitzailea..." />
                        <Label fx:id="lblHornitzaileInfo" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="CIF eta BEZ informazioa" />
                    </VBox>

                    <VBox spacing="3.0">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="2. Aukeratu Produktua / Lehengaia:" />
                        <ComboBox fx:id="cmbLehengaia" maxWidth="Infinity" promptText="Aukeratu lehengaia..." />
                    </VBox>

                    <HBox spacing="10.0">
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblKantitateaLabel" style="-fx-font-weight: bold; -fx-font-size: 12px;" text="3. Kantitatea:" />
                            <TextField fx:id="txtKantitatea" promptText="Adib. 10" />
                        </VBox>
                        <VBox spacing="3.0" prefWidth="150.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Ordainketa Metodoa:" />
                            <ComboBox fx:id="cmbOrdainketaMetodoa" maxWidth="Infinity" />
                        </VBox>
                    </HBox>

                    <HBox spacing="10.0">
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Albaran Zk. (aukerakoa):" />
                            <TextField fx:id="txtAlbarana" promptText="Hutsik = automatikoa" />
                        </VBox>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Oharrak:" />
                            <TextField fx:id="txtOharrak" promptText="Hornitzailearen oharrak..." />
                        </VBox>
                    </HBox>

                    <!-- KOBRO / ORDAINKETA SIMULAZIOAREN LABURPENA -->
                    <VBox spacing="4.0" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="ORDAINKETA SIMULAZIOA (EROSKETA FAKTURA)" />
                        <Label fx:id="lblKostuOinarria" style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Oinarri zergagarria: 0.00 €" />
                        <Label fx:id="lblKostuBeza" style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="BEZ (%10): 0.00 €" />
                        <Label fx:id="lblKostuGuztira" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #15803d;" text="GUZTIRA ORDAINTZEKO: 0.00 €" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <Button fx:id="btnGordeSarrera" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSarreraErregistratuClick" styleClass="btn-success" text="+ Albarana Sartu eta Ordaindu" />
                </VBox>
            </SplitPane>
        </VBox>
    </center>

    <!-- 3. BEHEKO EGOERA-BARRA -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="status-bar">
            <Label fx:id="lblIturria" styleClass="status-ok" text="Iturria: API (http://localhost:5050/api/v1/lehengaiak)" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblEgoeraMezua" styleClass="status-text" text="Prest" />
        </HBox>
    </bottom>
</BorderPane>
