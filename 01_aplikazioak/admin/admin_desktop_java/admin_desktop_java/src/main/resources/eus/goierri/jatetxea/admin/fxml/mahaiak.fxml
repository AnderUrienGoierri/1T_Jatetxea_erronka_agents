<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.goierri.jatetxea.admin.controller.MahaiakKontrolagailua"
      stylesheets="@../css/app.css"
      spacing="18" styleClass="screen">
    <padding>
        <Insets top="2" right="2" bottom="2" left="2"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="14">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Mahaiak" styleClass="page-title"/>
            <Label text="Kudeatu mahai-zenbakiak, edukierak eta egoerak." styleClass="muted-text"/>
        </VBox>
        <Button text="Zerrenda berritu" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>
    <Label text="Mahai bat editatzeko libre egon behar du eta gaurko edo etorkizuneko erreserbarik ez izan. Beste mahaien zerbitzuak ez du editatzea blokeatzen."
           wrapText="true" styleClass="callout"/>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card">
            <Label text="Mahai-zerrenda" styleClass="section-title"/>
            <TableView fx:id="tablesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="numberColumn" text="Zenbakia" prefWidth="110"/>
                    <TableColumn fx:id="capacityColumn" text="Edukiera" prefWidth="110"/>
                    <TableColumn fx:id="areaColumn" text="Eremua" prefWidth="200"/>
                    <TableColumn fx:id="stateColumn" text="Egoera / erabilgarritasuna" prefWidth="190"/>
                </columns>
            </TableView>
            <Label fx:id="tablesMessage" text="Mahaiak kargatzen..." wrapText="true" styleClass="inline-message"/>
        </VBox>
        <VBox prefWidth="330" spacing="14" styleClass="card">
            <Label text="Mahai berria" styleClass="section-title"/>
            <VBox spacing="6">
                <Label text="Mahai-zenbakia" styleClass="field-label"/>
                <TextField fx:id="numberField" promptText="Adib. 12"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Edukiera" styleClass="field-label"/>
                <TextField fx:id="capacityField" promptText="Adib. 4"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Eremua / kokapena" styleClass="field-label"/>
                <ComboBox fx:id="areaCombo" maxWidth="Infinity"/>
            </VBox>
            <Button fx:id="createButton" text="Mahaia sortu" onAction="#createTable"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <Button fx:id="editTableButton" text="Hautatutakoa editatu" onAction="#editTable"
                    maxWidth="Infinity" styleClass="secondary-button"/>
            <Button fx:id="cancelEditButton" text="Edizioa utzi" onAction="#cancelEdit"
                    maxWidth="Infinity" styleClass="secondary-button"/>
            <Label text="Hautatutako mahaiaren egoera" styleClass="field-label"/>
            <ComboBox fx:id="stateCombo" maxWidth="Infinity"/>
            <Button fx:id="updateStateButton" text="Egoera eguneratu" onAction="#updateTableState"
                    maxWidth="Infinity" styleClass="secondary-button"/>
            <Button fx:id="deactivateButton" text="Mahaia desgaitu" onAction="#deactivateTable"
                    maxWidth="Infinity" styleClass="danger-button"/>
        </VBox>
    </HBox>
</VBox>
