<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="eus.goierri.jatetxea.admin.controller.SaioHasieraKontrolagailua"
           stylesheets="@../css/app.css"
           styleClass="login-screen">
    <HBox maxWidth="980" maxHeight="570" styleClass="login-card">
        <VBox prefWidth="430" spacing="22" styleClass="login-brand-panel">
            <padding>
                <Insets top="46" right="42" bottom="42" left="42"/>
            </padding>
            <Label text="T1" styleClass="brand-mark"/>
            <VBox spacing="10">
                <Label text="Jatetxea" styleClass="login-brand-title"/>
                <Label text="Kudeaketa, xehetasunez." styleClass="login-brand-subtitle"/>
            </VBox>
            <Label text="Back-office plataforma&#10;Jabearentzat eta kudeatzaileentzat"
                   wrapText="true" styleClass="login-brand-copy"/>
            <Label text="ITALO-EUSKAL SUKALDEA" styleClass="brand-eyebrow"/>
        </VBox>
        <VBox prefWidth="550" spacing="18" styleClass="login-form-panel">
            <padding>
                <Insets top="58" right="64" bottom="52" left="64"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="api-status">
                <Circle fx:id="apiStatusDot" radius="5" fill="#d97706"/>
                <Label fx:id="apiStatusLabel" text="API egoera egiaztatzen..." styleClass="api-status-pending"
                       HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshApiButton" text="Berritu" onAction="#refreshApiStatus"
                        styleClass="text-button"/>
            </HBox>
            <Label text="Ongi etorri" styleClass="page-title"/>
            <Label text="Hasi saioa zure kudeatzaile-kontuarekin." styleClass="muted-text"/>
            <VBox spacing="8">
                <Label text="Erabiltzailea" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Erabiltzaile-izena"/>
            </VBox>
            <VBox spacing="8">
                <Label text="PINa edo pasahitza" styleClass="field-label"/>
                <PasswordField fx:id="pinField" promptText="Sartu PINa"/>
            </VBox>
            <Label fx:id="errorLabel" wrapText="true" styleClass="inline-message"/>
            <Button fx:id="signInButton" text="Saioa hasi" onAction="#signIn"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <Label text="Konexioa: REST API · Ez da datu-basera zuzenean konektatzen"
                   wrapText="true" styleClass="fine-print"/>
        </VBox>
    </HBox>
</StackPane>
