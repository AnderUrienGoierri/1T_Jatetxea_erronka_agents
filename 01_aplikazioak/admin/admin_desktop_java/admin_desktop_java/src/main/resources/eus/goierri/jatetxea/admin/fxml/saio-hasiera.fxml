<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane styleClass="login-screen" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.goierri.jatetxea.admin.controller.SaioHasieraKontrolagailua">
    <HBox maxHeight="570" maxWidth="980" styleClass="login-card">
        <VBox prefWidth="430" spacing="22" styleClass="login-brand-panel">
            <padding>
                <Insets bottom="42" left="42" right="42" top="46" />
            </padding>
            <Label styleClass="brand-mark" text="T1" />
            <VBox spacing="10">
                <Label styleClass="login-brand-title" text="Jatetxea" />
                <Label styleClass="login-brand-subtitle" text="Kudeaketa, xehetasunez." />
               <Label styleClass="brand-eyebrow" text="ITALO-EUSKAL SUKALDEA" />
            </VBox>
            <Label styleClass="login-brand-copy" text="Back-office plataforma&#10;Jabearentzat eta kudeatzaileentzat" wrapText="true" />
        </VBox>
        <VBox prefWidth="550" spacing="18" styleClass="login-form-panel">
            <padding>
                <Insets bottom="52" left="64" right="64" top="58" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="api-status">
                <Circle fx:id="apiStatusDot" fill="#d97706" radius="5" />
                <Label fx:id="apiStatusLabel" styleClass="api-status-pending" text="API egoera egiaztatzen..." HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshApiButton" onAction="#refreshApiStatus" styleClass="text-button" text="Berritu" />
            </HBox>
            <Label styleClass="page-title" text="Ongi etorri" />
            <Label styleClass="muted-text" text="Hasi saioa zure kudeatzaile edo admin kontuarekin." />
            <VBox spacing="8">
                <Label styleClass="field-label" text="Erabiltzailea" />
                <TextField fx:id="usernameField" promptText="Erabiltzaile-izena" />
            </VBox>
            <VBox spacing="8">
                <Label styleClass="field-label" text="PIN" />
                <PasswordField fx:id="pinField" promptText="Sartu PINa" />
            </VBox>
            <Label fx:id="errorLabel" styleClass="inline-message" wrapText="true" />
            <Button fx:id="signInButton" maxWidth="Infinity" onAction="#signIn" styleClass="primary-button" text="Saioa hasi" />
            <Label styleClass="fine-print" text="Konexioa: REST API · Ez da datu-basera zuzenean konektatzen" wrapText="true" />
        </VBox>
    </HBox>
</StackPane>
