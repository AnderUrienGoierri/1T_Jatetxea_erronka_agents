<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.goierri.jatetxea.admin.controller.TxataKontrolagailua"
      stylesheets="@../css/app.css"
      spacing="16" styleClass="screen">
    <padding>
        <Insets top="2" right="2" bottom="2" left="2"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="14">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Barne Txata (Gerentea ↔ TPV)" styleClass="page-title"/>
            <Label text="Komunikatu denbora errealean jangelako, barrako eta sukaldeko langileekin."
                   styleClass="muted-text"/>
        </VBox>
        <Label fx:id="chatStatusLabel" text="Egiaztatzen..." styleClass="status-warning"/>
        <ComboBox fx:id="roomCombo" prefWidth="150"/>
        <Button text="Berritu" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Mezuen elkarrizketa" styleClass="section-title"/>
        <ListView fx:id="messagesList" VBox.vgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="messageField" promptText="Idatzi mezua hemen eta sakatu Enter edo Bidali..."
                       onAction="#sendMessage" HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Bidali mezua" onAction="#sendMessage"
                    styleClass="primary-button" minWidth="130"/>
        </HBox>
        <Label fx:id="chatMessage" text="Txata prest." wrapText="true" styleClass="inline-message"/>
    </VBox>
</VBox>
